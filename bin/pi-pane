#!/bin/sh
# Start an interactive pi in a new herdr pane on the model modelcmp picks, hand it a task, print its answer.
#   pi-pane <name> <task> <tier> <prompt-file|->     e.g.  pi-pane build coding mid task.md
# The pane stays open: type into it, or send more with `herdr agent prompt <name> "..." --wait`.
set -eu
[ "${HERDR_ENV:-}" = 1 ] || { echo "pi-pane: not inside herdr" >&2; exit 1; }
[ $# -eq 4 ] || { sed -n '2,4s/^# \{0,1\}//p' "$0" >&2; exit 1; }
name=$1 prompt=$(cat "$4")
model=$(modelcmp list --task "$2" --tier "$3" --via pi --id 2>/dev/null | head -1)
[ -n "$model" ] || { echo "pi-pane: modelcmp has no $2 $3 model on pi" >&2; exit 1; }
pane=$(herdr pane split --current --direction right --cwd "$PWD" --no-focus | jq -r .result.pane.pane_id)
herdr agent start "$name" --kind pi --pane "$pane" --timeout 60000 -- --model "$model" >/dev/null
echo "pi-pane: $name on $model in pane $pane" >&2
send() { herdr agent prompt "$name" "$prompt" --wait --timeout "${PI_PANE_TIMEOUT:-600000}" >/dev/null 2>&1; }
# ponytail: a pi that is still drawing its start-up notices drops the first prompt, so send once more.
# If herdr ever reports a stall after delivering, this sends the task twice: check the pane first then.
send || { sleep 2; send; }
herdr agent read "$name" --source recent-unwrapped --lines 200 | jq -r '.result.read.text // .'
