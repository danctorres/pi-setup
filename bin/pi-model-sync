#!/bin/sh
# Set each pi-subagents role's model to modelcmp's pick for its task and tier.
#   pi-model-sync [settings.json]    default .pi/settings.json (this repo); ~/.pi/agent/settings.json for every repo
# Roles come from .pi/subagent-models when it exists ("role task tier" per line), else the table below.
set -eu
f=${1:-.pi/settings.json}
mkdir -p "$(dirname "$f")"
[ -s "$f" ] || echo '{}' > "$f"
if [ -f .pi/subagent-models ]; then roles=$(grep '^[a-z]' .pi/subagent-models); else roles='scout value low
worker coding mid
reviewer reasoning high
oracle reasoning high
researcher agentic mid
evidence-auditor reasoning mid'; fi
echo "$roles" | while read -r role task tier; do
  id=$(modelcmp list --task "$task" --tier "$tier" --via pi --id 2>/dev/null | head -1)
  if [ -z "$id" ]; then echo "pi-model-sync: no $task $tier model on pi, $role keeps its model" >&2; continue; fi
  jq --arg r "$role" --arg m "$id" '.subagents.agentOverrides[$r].model = $m' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  echo "$role  $task/$tier  $id"
done
w=$(jq -r '.subagents.agentOverrides.worker.model // empty' "$f") r=$(jq -r '.subagents.agentOverrides.reviewer.model // empty' "$f")
[ -z "$w" ] || [ "$w" != "$r" ] || echo "pi-model-sync: worker and reviewer are both $w; log in to another provider or pin one in $f so the review is a second opinion" >&2
